# Email для уведомлений Let's Encrypt — необязателен и подставляется setup.sh,
# если задан EMAIL. Используйте реальный домен: example.com и подобные
# Let's Encrypt отклоняет с ошибкой invalidContact.

# Заголовки безопасности и сжатие — общие для всех сайтов зоны.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	encode zstd gzip
}

__DOMAIN__ {
	import security

	# Аптайм-чек: отвечает до file_server, не зависит от содержимого.
	respond /healthz "ok" 200

	root * /srv/vesha/www/landing
	file_server

	# Своя 404-страница; статус ответа сохраняется.
	handle_errors {
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}

	# Картинки и шрифты — надолго; JS/CSS — с ревалидацией, чтобы правки
	# витрин не залипали в кэше; HTML — никогда.
	@assets path /assets/* *.woff2 *.png *.svg *.webp *.jpg *.jpeg *.gif *.ico
	header @assets Cache-Control "public, max-age=2592000"

	@code path *.js *.css
	header @code Cache-Control "public, max-age=3600"

	@html path / *.html */
	header @html Cache-Control "no-cache"
}
