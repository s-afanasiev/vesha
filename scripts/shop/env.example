# Сайт магазина: скопируйте в .env (права 600) и заполните.

# ---- сервер -----------------------------------------------------------------
PORT=3000
# За nginx — только локальный адрес; пусто — все адреса машины.
HOST=127.0.0.1
# Ровно за одним доверенным прокси (nginx): иначе у всех покупателей один IP и
# защита формы «5 заявок за 10 минут с адреса» срабатывает на весь сайт.
TRUST_PROXY=true

# ---- база Postgres ----------------------------------------------------------
DATABASE_URL=postgres://shop:<пароль базы>@localhost:5432/shop
# DATABASE_SSL=false

# Подпись cookie входа: длинная случайная строка (openssl rand -hex 32).
SESSION_SECRET=

# Админ экземпляра (почта через запятую): заводит магазины и сотрудников, видит
# все магазины. Почты сотрудников сюда не пишем — их добавляют в кабинете.
ADMIN_EMAILS=

# ---- витрина ----------------------------------------------------------------
# Адрес магазина из кабинета («Магазины»): корень сайта ведёт на его витрину.
SHOP_HOME=demo-krepezh
# Адрес сайта для ссылок в письмах; кириллический домен — в punycode.
BACKBONE_PUBLIC_URL=http://localhost:3000

# ---- почта: квитанции покупателям и письма менеджеру ------------------------
# Ящик-отправитель — тот же, что BACKBONE_SMTP_USER. Без SMTP письма пишутся
# файлами .eml в BACKBONE_MAIL_DIR (по умолчанию data/backbone-mail) — покупатель
# их не получит. Порт 465 — TLS сразу, 587 — STARTTLS.
BACKBONE_MAIL_FROM=
# BACKBONE_SMTP_HOST=smtp.yandex.ru
# BACKBONE_SMTP_PORT=465
# BACKBONE_SMTP_USER=
# BACKBONE_SMTP_PASS=
# BACKBONE_MAIL_DIR=
# Защита формы: не больше N заявок с одного адреса за окно в минутах.
# BACKBONE_SITE_PER_IP=5
# BACKBONE_SITE_WINDOW_MIN=10

# ---- модель: строки заявки, которые не разобрали правила, черновик ассистента ----
# OpenAI-совместимый шлюз. Без ключа заявки разбираются правилами, остальное
# менеджер видит как «не разобрано»; контакты покупателей модели не уходят.
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=
# Запросов к модели в час на сотрудника и одновременных вызовов (на 1 ГБ — 1–2).
# LLM_USER_REQUESTS_PER_HOUR=60
# LLM_MAX_CONCURRENT=4

# ---- вход через Google (по желанию) -----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://<домен>/api/auth/google/callback
