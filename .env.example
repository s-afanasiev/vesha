PORT=3000

# PostgreSQL (Локальный сервер или удаленный VDS/VPS)
# Вариант 1: Единая строка подключения (URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vesha

# Вариант 2: Отдельные переменные (раскомментируйте, если не используете DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=vesha
# DATABASE_SSL=false

SESSION_SECRET=change-me-to-a-long-random-string

# Vision
GEMINI_API_KEY=
OPENAI_API_KEY=

# Search (Yandex via SerpAPI). Without key — demo offers.
SERPAPI_API_KEY=

# Replicate (background removal). Alt model: 851-labs/background-remover
REPLICATE_API_TOKEN=
REPLICATE_REMOVE_BG_MODEL=lucataco/remove-bg

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# yt-dlp + ffmpeg (npm run media-bins → bin/)
MEDIA_BIN_DIR=
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
SUMMARIZE_MAX_DURATION_SEC=10800
SUMMARIZE_TIMEOUT_MS=600000
SUMMARIZE_MAX_FILESIZE=80M

GUEST_UPLOADS_PER_DAY=3
USER_UPLOADS_PER_DAY=30
GUEST_OFFER_LIMIT=5
USER_OFFER_LIMIT=30
