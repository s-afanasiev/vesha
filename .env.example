PORT=3000
# Если приложение стоит ровно за одним доверенным reverse proxy (Nginx/Caddy):
# TRUST_PROXY=true

# ---- PostgreSQL: где живёт база ------------------------------------------
# DB_MODE выбирает режим:
#   native — Postgres установлен прямо в системе (VDS без docker, порт 5432)
#   docker — база поднята контейнером из docker-compose.yml (порт 5434)
# Явные DATABASE_URL или PGPORT сильнее DB_MODE. Серверу достаточно Node.js —
# docker нужен только если выбрали режим docker.
DB_MODE=native

# Вариант 1: единая строка подключения (URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vesha
# для режима docker раскомментируйте строку ниже (порт 5434) и закомментируйте верхнюю:
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/vesha

# Вариант 2: отдельные переменные (используются, если DATABASE_URL не задан).
# Порт по умолчанию берётся из DB_MODE: native → 5432, docker → 5434.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=vesha
# DATABASE_SSL=false

SESSION_SECRET=change-me-to-a-long-random-string

# Админы — email через запятую (вход на сайте под этим email). Видят служебные
# плитки и части каталога экспериментов: пульт 2ГИС в pain-radar, опрос и разметку
# в idea-radar. Пусто — админа нет, служебные API отвечают 403.
ADMIN_EMAILS=

# Vision / LLM picker (Gemini)
LLM_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Если VDS в стране, где Gemini API закрыт (User location is not supported):
# GEMINI_HTTPS_PROXY=http://user:pass@host:port
# OPENAI_API_KEY=  — запасной путь: Whisper + GPT
# SUMMARIZE_MOCK=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Для локального OpenAI-compatible сервера без авторизации (например Ollama):
# OPENAI_ALLOW_KEYLESS=true
# Сторонний OpenAI-compatible провайдер только для LLM-шлюза (llm-picker, разметка радара).
# Набор целиком: задан хоть один LLM_OPENAI_* — шлюз берёт только их, OPENAI_* остаются
# прямым ключом OpenAI для vision и Whisper (они ходят на api.openai.com).
# LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENAI_MODEL=
# LLM_OPENAI_API_KEY=

# YandexGPT (блок llm-picker). Для IAM-токена используйте отдельную переменную.
YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite/latest

# LLM gateway security and limits.
LLM_TIMEOUT_MS=180000
LLM_MAX_INPUT_CHARS=300000
LLM_MAX_RESPONSE_BYTES=4194304
LLM_MAX_TOKENS=32768
# Более строгий потолок, когда расходуется ключ сервера:
LLM_SERVER_MAX_TOKENS=16384
LLM_GUEST_REQUESTS_PER_HOUR=10
# Пауза гостя между LLM-запросами, секунды (0 — без паузы); у вошедших паузы нет:
LLM_GUEST_COOLDOWN_SEC=30
LLM_USER_REQUESTS_PER_HOUR=60
LLM_MAX_CONCURRENT=4
# В development пользовательские публичные HTTPS URL включены по умолчанию.
# В production они выключены; для включения задайте оба значения:
# LLM_ENABLE_CUSTOM_ENDPOINTS=true
# LLM_ALLOWED_OPENAI_HOSTS=api.openai.com,openrouter.ai,api.groq.com
# Локальные/private endpoint (например Ollama) — только осознанно на доверенном сервере:
# LLM_ALLOW_PRIVATE_ENDPOINTS=true

# Search (Yandex via SerpAPI). Without key — demo offers.
SERPAPI_API_KEY=

# Replicate (background removal). Alt model: 851-labs/background-remover
REPLICATE_API_TOKEN=
REPLICATE_REMOVE_BG_MODEL=lucataco/remove-bg

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# yt-dlp + ffmpeg (npm run media-bins → bin/)
MEDIA_BIN_DIR=
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
SUMMARIZE_MAX_DURATION_SEC=10800
SUMMARIZE_TIMEOUT_MS=600000
SUMMARIZE_MAX_FILESIZE=80M

# Радар идей: опрос лент. 0 — только кнопкой на странице; 360 — раз в 6 часов.
# Ленты региональных СМИ помнят около суток: для рядов по неделям нужен хотя бы ежедневный опрос.
IDEA_RADAR_POLL_EVERY_MIN=0
IDEA_RADAR_MIN_POLL_INTERVAL_SEC=300
IDEA_RADAR_PAGE_TIMEOUT_MS=20000
IDEA_RADAR_POLL_DEADLINE_MS=90000
IDEA_RADAR_MAX_BYTES=5242880
# Сколько PDF госактов разбирать за один запуск доставки текста (POST /gov-texts).
IDEA_RADAR_GOV_TEXTS_BATCH=20

# «Кому автоматизировать»: корень корпусов ниш — niches/<slug>/ (orgs.json, audit-*.json,
# reviews.ndjson, marks.jsonl, meta.json). Пишет кнопка «Собрать», читает «Разобрать»:
# процессу сервера нужно право записи. По умолчанию — data/pain-radar-corpus (вне git).
# AUTOMATION_LEADS_DATA_DIR=/srv/vesha/data/pain-radar-corpus
# 2ГИС: пауза между обращениями (мс) и остывание после 403/429 (мин); публичный фронтовый
# ключ reviews API — не секрет, задан по умолчанию.
# TWOGIS_GAP_MS=1600
# TWOGIS_COOLDOWN_MIN=30
# TWOGIS_REVIEWS_KEY=

# Костяк, разбор заявки в счёт: строки, которые не разобрали правила, идут в модель.
# gateway (по умолчанию) — шлюз LLM с серверным пресетом LLM_OPENAI_* и квотой того, кто нажал
# «Разобрать»; recorded — записанные ответы демо-заявки (invoice/fixtures), без сети и ключа.
# BACKBONE_MODEL=gateway
# Костяк, витрина: адрес сайта для ссылок на окно статуса в квитанциях;
# без SMTP почта квитанций пишется файлами .eml в BACKBONE_MAIL_DIR (по умолчанию data/backbone-mail).
# BACKBONE_PUBLIC_URL=http://localhost:3000
# BACKBONE_MAIL_DIR=
# BACKBONE_MAIL_FROM — адрес отправителя: ящик, от имени которого SMTP разрешает слать.
# BACKBONE_MAIL_FROM=noreply@vesha.local
# Квитанции настоящим письмом: задан хост — SMTP, иначе — файлы .eml. Порт 465 — TLS сразу,
# 587 — STARTTLS; без TLS пароль уходит только на localhost. Ответ клиента — на почту магазина
# (Reply-To из карточки магазина в кабинете).
# BACKBONE_SMTP_HOST=
# BACKBONE_SMTP_PORT=
# BACKBONE_SMTP_SECURE=
# BACKBONE_SMTP_USER=
# BACKBONE_SMTP_PASS=
# Защита формы «заявка списком»: не больше N заявок с одного адреса за окно в минутах.
# BACKBONE_SITE_PER_IP=5
# BACKBONE_SITE_WINDOW_MIN=10

# Путь для замера свободного места (индикатор «диск»); по умолчанию — каталог запуска сервера.
# На Linux-сервере укажите том, где реально растут данные (БД/загрузки).
# DISK_INFO_PATH=/srv/vesha

GUEST_UPLOADS_PER_DAY=3
USER_UPLOADS_PER_DAY=30
GUEST_OFFER_LIMIT=5
USER_OFFER_LIMIT=30
